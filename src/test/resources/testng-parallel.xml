<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM-Parallel-Suite" verbose="1" thread-count="3" parallel="tests">

    <listeners>
        <listener class-name="com.orangehrm.listeners.TestListener"/>
    </listeners>

    <test name="Auth-Tests-Thread1">
        <classes>
            <class name="com.orangehrm.tests.AuthenticationTest"/>
        </classes>
    </test>

    <test name="Employee-Creation-Thread2">
        <classes>
            <class name="com.orangehrm.tests.EmployeeCreationTest"/>
        </classes>
    </test>

    <test name="RBAC-API-Thread3">
        <classes>
            <class name="com.orangehrm.tests.RoleBasedValidationTest"/>
            <class name="com.orangehrm.tests.ApiVerificationTest"/>
        </classes>
    </test>

</suite>
