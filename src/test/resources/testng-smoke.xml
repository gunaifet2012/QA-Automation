<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM-Smoke-Suite" verbose="1" thread-count="1">

    <listeners>
        <listener class-name="com.orangehrm.listeners.TestListener"/>
    </listeners>

    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.orangehrm.tests.AuthenticationTest"/>
            <class name="com.orangehrm.tests.EmployeeCreationTest"/>
        </classes>
    </test>

</suite>
